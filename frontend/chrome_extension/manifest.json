{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "KickDanmu",
  "description": "__MSG_extDescription__",
  "version": "1.0.0",
  "homepage_url": "https://github.com/Feeengyuuu/KickDanmu",
  "icons": {
    "16": "image/icon_16.png",
    "32": "image/icon_32.png",
    "48": "image/icon_48.png",
    "128": "image/app_icon.png"
  },
  "default_locale": "en",
  "content_scripts": [
    {
      "matches": [
        "https://kick.com/*",
        "https://www.youtube.com/*",
        "https://www.twitch.tv/*"
      ],
      "js": [
        "content_script/index.js"
      ],
      "run_at": "document_end"
    }
  ]
}
